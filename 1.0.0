-- =================================================================
-- MING KHANG HUB - BẢN TIẾNG VIỆT
-- =================================================================

local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local Title = Instance.new("TextLabel")
local SpeedBtn = Instance.new("TextButton")
local JumpBtn = Instance.new("TextButton")
local NoclipBtn = Instance.new("TextButton")
local UICorner = Instance.new("UICorner")

-- Cấu hình GUI chính
ScreenGui.Parent = game.CoreGui
ScreenGui.Name = "MingKhangHub"

MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
MainFrame.Position = UDim2.new(0.3, 0, 0.3, 0)
MainFrame.Size = UDim2.new(0, 220, 0, 240)
MainFrame.Active = true
MainFrame.Draggable = true -- Có thể kéo thả giao diện

local FrameCorner = Instance.new("UICorner")
FrameCorner.CornerRadius = UDim.new(0, 10)
FrameCorner.Parent = MainFrame

-- Tiêu đề Hub
Title.Name = "Title"
Title.Parent = MainFrame
Title.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
Title.Size = UDim2.new(1, 0, 0, 40)
Title.Font = Enum.Font.SourceSansBold
Title.Text = "MING KHANG HUB"
Title.TextColor3 = Color3.fromRGB(0, 255, 127)
Title.TextSize = 20.000

local TitleCorner = Instance.new("UICorner")
TitleCorner.CornerRadius = UDim.new(0, 10)
TitleCorner.Parent = Title

-- 1. NÚT CHẠY NHANH VÔ HẠN
SpeedBtn.Name = "SpeedBtn"
SpeedBtn.Parent = MainFrame
SpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
SpeedBtn.Position = UDim2.new(0.1, 0, 0.23, 0)
SpeedBtn.Size = UDim2.new(0.8, 0, 0, 35)
SpeedBtn.Font = Enum.Font.SourceSans
SpeedBtn.Text = "Chạy Nhanh: TẮT"
SpeedBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
SpeedBtn.TextSize = 16.000

local SpeedOn = false
SpeedBtn.MouseButton1Click:Connect(function()
    SpeedOn = not SpeedOn
    if SpeedOn then
        SpeedBtn.Text = "Chạy Nhanh: BẬT"
        SpeedBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        SpeedBtn.Text = "Chạy Nhanh: TẮT"
        SpeedBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 16
        end
    end
end)

-- Vòng lặp giữ tốc độ liên tục (tránh bị game reset tốc độ)
task.spawn(function()
    while task.wait(0.1) do
        if SpeedOn and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = 100 -- Chỉnh tốc độ tùy ý ở đây
        end
    end
end)

-- 2. NÚT NHẢY CAO / VÔ HẠN
JumpBtn.Name = "JumpBtn"
JumpBtn.Parent = MainFrame
JumpBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
JumpBtn.Position = UDim2.new(0.1, 0, 0.43, 0)
JumpBtn.Size = UDim2.new(0.8, 0, 0, 35)
JumpBtn.Font = Enum.Font.SourceSans
JumpBtn.Text = "Nhảy Cao: TẮT"
JumpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
JumpBtn.TextSize = 16.000

local JumpOn = false
JumpBtn.MouseButton1Click:Connect(function()
    JumpOn = not JumpOn
    if JumpOn then
        JumpBtn.Text = "Nhảy Cao: BẬT"
        JumpBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        JumpBtn.Text = "Nhảy Cao: TẮT"
        JumpBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        if game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.JumpPower = 50
        end
    end
end)

task.spawn(function()
    while task.wait(0.1) do
        if JumpOn and game.Players.LocalPlayer.Character and game.Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
            game.Players.LocalPlayer.Character.Humanoid.JumpPower = 120 -- Chỉnh lực nhảy tùy ý ở đây
        end
    end
end)

-- 3. NÚT ĐI XUYÊN TƯỜNG (NOCLIP)
NoclipBtn.Name = "NoclipBtn"
NoclipBtn.Parent = MainFrame
NoclipBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
NoclipBtn.Position = UDim2.new(0.1, 0, 0.63, 0)
NoclipBtn.Size = UDim2.new(0.8, 0, 0, 35)
NoclipBtn.Font = Enum.Font.SourceSans
NoclipBtn.Text = "Đi Xuyên Tường: TẮT"
NoclipBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
NoclipBtn.TextSize = 16.000

local NoclipOn = false
NoclipBtn.MouseButton1Click:Connect(function()
    NoclipOn = not NoclipOn
    if NoclipOn then
        NoclipBtn.Text = "Đi Xuyên Tường: BẬT"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
    else
        NoclipBtn.Text = "Đi Xuyên Tường: TẮT"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    end
end)

-- Xử lý va chạm để xuyên tường
game:GetService("RunService").Stepped:Connect(function()
    if NoclipOn and game.Players.LocalPlayer.Character then
        for _, part in pairs(game.Players.LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)
